# Database URLs (Configured for Supabase / PostgreSQL)
# PgBouncer pooled connection (Port 6543)
DATABASE_URL="postgresql://postgres.example:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations (Port 5432)
DIRECT_URL="postgresql://postgres.example:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT Secret for Auth
JWT_SECRET="kurazprep-super-secret-jwt-key-change-in-production"

# Server Configuration
PORT=3000
HOST="0.0.0.0"
